  "info": {
    "title": "Masraf Bildirim API",
    "description": "Masraf bildirim ve onay API'si.\n\n**Akış:** Taslak → Yönetici Onayı Bekliyor → Muhasebe Onayı Bekliyor → Onaylandı\n(yönetici veya muhasebe reddederse → Reddedildi).\n\n**Kimlik doğrulama:** `POST /auth/login` ile alınan token, `Authorization: Bearer <token>` başlığıyla gönderilir.\nDemo kullanıcılar: ali, veli (çalışan), ahmet (yönetici), ayse (muhasebe); şifre `Demo123!`.\n\n**Görünürlük:** Her kullanıcı sadece kendi kapsamındaki masrafları görür. Kapsam dışındaki bir masraf,\nvarlığını sızdırmamak için 403 yerine **404** döner.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "enum": [
              "EMPLOYEE",
              "MANAGER",
              "ACCOUNTING"
            ],
            "type": "string"
          },
          "managerId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "fullName",
          "role",
          "managerId"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token, 8 saat geçerli"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {}
      },
      "PersonSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName"
        ]
      },
      "ExpenseSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "expenseDate": {
            "type": "string",
            "description": "Masraf tarihi, YYYY-MM-DD"
          },
          "category": {
            "enum": [
              "TRANSPORT",
              "MEAL",
              "ACCOMMODATION",
              "OTHER"
            ],
            "type": "string"
          },
          "amount": {
            "type": "string",
            "description": "İki ondalıklı metin olarak tutar, örn. \"750.00\" (kayan nokta hatası olmaması için)"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "enum": [
              "DRAFT",
              "PENDING_MANAGER",
              "PENDING_ACCOUNTING",
              "APPROVED",
              "REJECTED"
            ],
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/PersonSummary"
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true
          },
          "rejectedBy": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PersonSummary"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "expenseDate",
          "category",
          "amount",
          "note",
          "status",
          "owner",
          "rejectionReason",
          "rejectedBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "HistoryActor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "EMPLOYEE",
              "MANAGER",
              "ACCOUNTING"
            ]
          }
        },
        "required": [
          "id",
          "fullName",
          "role"
        ]
      },
      "ExpenseHistoryEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPDATED",
              "SUBMITTED",
              "MANAGER_APPROVED",
              "MANAGER_REJECTED",
              "ACCOUNTING_APPROVED",
              "ACCOUNTING_REJECTED"
            ]
          },
          "fromStatus": {
            "type": "string",
            "nullable": true,
            "enum": [
              "DRAFT",
              "PENDING_MANAGER",
              "PENDING_ACCOUNTING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "toStatus": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_MANAGER",
              "PENDING_ACCOUNTING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "description": "Red gerekçesi (sadece red işlemlerinde)"
          },
          "actor": {
            "$ref": "#/components/schemas/HistoryActor"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "action",
          "fromStatus",
          "toStatus",
          "reason",
          "actor",
          "createdAt"
        ]
      },
      "ExpenseDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "expenseDate": {
            "type": "string",
            "description": "Masraf tarihi, YYYY-MM-DD"
          },
          "category": {
            "enum": [
              "TRANSPORT",
              "MEAL",
              "ACCOMMODATION",
              "OTHER"
            ],
            "type": "string"
          },
          "amount": {
            "type": "string",
            "description": "İki ondalıklı metin olarak tutar, örn. \"750.00\" (kayan nokta hatası olmaması için)"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "enum": [
              "DRAFT",
              "PENDING_MANAGER",
              "PENDING_ACCOUNTING",
              "APPROVED",
              "REJECTED"
            ],
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/PersonSummary"
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true
          },
          "rejectedBy": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PersonSummary"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "history": {
            "description": "İşlem geçmişi, eskiden yeniye",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseHistoryEntry"
            }
          }
        },
        "required": [
          "id",
          "title",
          "expenseDate",
          "category",
          "amount",
          "note",
          "status",
          "owner",
          "rejectionReason",
          "rejectedBy",
          "createdAt",
          "updatedAt",
          "history"
        ]
      },
      "ExpenseFormDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 1000000,
            "minimum": 0.01,
            "description": "TL cinsinden tutar, en fazla 2 ondalık basamak",
            "example": 750
          },
          "title": {
            "type": "string",
            "description": "Masraf başlığı",
            "maxLength": 200
          },
          "expenseDate": {
            "type": "string",
            "description": "Masraf tarihi, YYYY-MM-DD; Türkiye saatine göre bugünden ileri olamaz"
          },
          "category": {
            "enum": [
              "TRANSPORT",
              "MEAL",
              "ACCOMMODATION",
              "OTHER"
            ],
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "description": "İsteğe bağlı açıklama",
            "maxLength": 1000
          }
        },
        "required": [
          "amount",
          "title",
          "expenseDate",
          "category"
        ]
      },
      "RejectExpenseDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
