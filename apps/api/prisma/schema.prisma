generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ACCOUNTING
}

enum ExpenseCategory {
  TRANSPORT
  MEAL
  ACCOMMODATION
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_ACCOUNTING
  APPROVED
  REJECTED
}

enum ExpenseAction {
  CREATED
  UPDATED
  SUBMITTED
  MANAGER_APPROVED
  MANAGER_REJECTED
  ACCOUNTING_APPROVED
  ACCOUNTING_REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  role         Role
  managerId    String?  @map("manager_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  manager          User?            @relation("ManagerReports", fields: [managerId], references: [id])
  directReports    User[]           @relation("ManagerReports")
  expenses         Expense[]        @relation("ExpenseOwner")
  rejectedExpenses Expense[]        @relation("ExpenseRejecter")
  actions          ExpenseHistory[]

  @@map("users")
}

model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  title           String          @db.VarChar(200)
  expenseDate     DateTime        @map("expense_date") @db.Date
  category        ExpenseCategory
  /// Turkish lira, stored as exact decimal to avoid floating point errors.
  amount          Decimal         @db.Decimal(12, 2)
  note            String?         @db.VarChar(1000)
  status          ExpenseStatus   @default(DRAFT)
  ownerId         String          @map("owner_id") @db.Uuid
  rejectionReason String?         @map("rejection_reason") @db.VarChar(500)
  rejectedById    String?         @map("rejected_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  owner      User             @relation("ExpenseOwner", fields: [ownerId], references: [id])
  rejectedBy User?            @relation("ExpenseRejecter", fields: [rejectedById], references: [id])
  history    ExpenseHistory[]

  @@index([ownerId, status])
  @@index([status])
  @@map("expenses")
}

/// Append-only audit log: one row per action taken on an expense.
model ExpenseHistory {
  id         String         @id @default(uuid()) @db.Uuid
  expenseId  String         @map("expense_id") @db.Uuid
  actorId    String         @map("actor_id") @db.Uuid
  action     ExpenseAction
  fromStatus ExpenseStatus? @map("from_status")
  toStatus   ExpenseStatus  @map("to_status")
  reason     String?        @db.VarChar(500)
  createdAt  DateTime       @default(now()) @map("created_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([expenseId, createdAt])
  @@map("expense_history")
}
